# ──────────────────────────────────────────────────────────────
#  Pango frontend — environment
#  Copy to `.env.local` and fill in. Never commit the real file.
#  The backend has its own .env.example in ../backend — this app
#  talks to it over HTTP and holds no database credentials.
# ──────────────────────────────────────────────────────────────

# Origin of the backend API. Used for the /api/* rewrite (browser calls stay
# same-origin) and for server-side fetches (e.g. the homepage's /api/home call).
BACKEND_URL=http://localhost:4000

# Safe to expose — used by the browser for direct uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare R2 public bucket URL (only needed for next/image remote patterns).
# Keep the matching R2_* credentials in backend/.env.
NEXT_PUBLIC_R2_PUBLIC_URL=
