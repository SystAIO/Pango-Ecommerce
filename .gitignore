# ── Secrets — never commit these ──────────────────────────────
# .env files hold the database URL, JWT secret, payment keys, R2 credentials
# and Gmail app password. .env.example files ARE committed (values are blank).
.env
.env.local
.env.*.local
!.env.example

# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches

# ── Build output ───────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Tooling caches ─────────────────────────────────────────────
.turbo/
.cache/
.eslintcache
coverage/
*.lcov

# ── Local test database (PGlite fixtures) ─────────────────────
.pglite/
*.pglite/

# ── Runtime local data and uploaded images ────────────────────
# Admin content falls back to JSON files until SQL migrations are applied,
# and local image uploads are written to disk. Neither belongs in git.
.data/
backend/uploads/
frontend/public/uploads/

# ── OS / editor noise ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
