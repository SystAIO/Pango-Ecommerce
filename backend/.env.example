# ──────────────────────────────────────────────────────────────
#  Pango backend — environment
#  Copy to `.env` and fill in. Never commit the real file.
# ──────────────────────────────────────────────────────────────

# Port the API listens on (the frontend proxies /api/* here).
PORT=4000

# Public origin of the Next.js frontend (used only for CORS fallback).
FRONTEND_URL=http://localhost:3000

# ─── Supabase (Postgres) ──────────────────────────────────────
# Project → Settings → API.
# SUPABASE_URL is safe to expose; the service-role key is NOT and must
# only ever be read by this backend (it bypasses row-level security).
# (NEXT_PUBLIC_SUPABASE_URL is still accepted as a fallback for legacy .env files.)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ─────────────────────────────────────────────────────
# Sign a random 64+ character string. Used to sign the session JWT.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ─── Gmail (order confirmation / cancellation emails) ─────────
# Use a Gmail app password, not the account password. Emails are a no-op if empty.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Cloudflare R2 (image storage) ────────────────────────────
# R2 API token needs Object Read & Write on the bucket. The public URL can be
# a custom domain or the bucket's r2.dev address. Uploads are a no-op to R2
# when any of these are missing (Cloudinary / data URL is used instead).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# ─── Razorpay (payments) ──────────────────────────────────────
# Dashboard → Settings → API Keys. Test keys work against Razorpay test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Cloudinary (product image uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Safe to expose — also read by the frontend for direct uploads (see frontend/.env.example).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
